{
  "name": "mapas-cliente",
  "version": "1.0.0",
  "description": "Cliente do jogo MAPAS (Phaser 3 + Vite)",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "vite build",
    "checar": "tsc -p tsconfig.json",
    "testar": "node --experimental-strip-types --no-warnings --import ./src/mochila/testes/resolver.mjs --test \"src/**/*.teste.mjs\"",
    "cobertura": "node --experimental-strip-types --no-warnings --import ./src/mochila/testes/resolver.mjs --test --experimental-test-coverage --test-coverage-exclude=\"src/**/*.teste.mjs\" --test-coverage-exclude=\"src/**/testes/**\" --test-coverage-lines=78 --test-coverage-branches=90 --test-coverage-functions=79 \"src/**/*.teste.mjs\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "private": true
}
